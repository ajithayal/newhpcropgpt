# AjiCorehpc Manager Production Environment Template
# Configured automatically by deploy.sh or manual setup
# Location: /opt/ajicorehpc/config/.env

# Application Configuration
APP_NAME=AjiCorehpc
ENVIRONMENT=production
DEBUG=false
INSTALL_PATH=/opt/ajicorehpc
AJICOREHPC_INSTALL_PATH=/opt/ajicorehpc

# Cryptographic & Session Security
SECRET_KEY=generate-with-openssl-rand-hex-32
AJICOREHPC_SECRET_KEY=generate-with-openssl-rand-hex-32
LICENSE_SIGNING_SECRET=generate-with-openssl-rand-hex-32

# Database (PostgreSQL recommended for production, or SQLite)
DATABASE_URL=postgresql+asyncpg://ajicorehpc:CHANGE_PASSWORD@localhost:5432/ajicorehpc
# DATABASE_URL=sqlite+aiosqlite:////opt/ajicorehpc/data/ajicorehpc.db

# Redis Configuration
REDIS_URL=redis://:CHANGE_PASSWORD@localhost:6379/0

# Local Storage and Backup Paths
STORAGE_BASE_PATH=/opt/ajicorehpc/data/storage
BACKUP_BASE_PATH=/opt/ajicorehpc/backups

# CORS Allowed Origins
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# Microsoft 365 / Enterprise SMTP Configuration (Can be configured via /setup)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ajicorehpc.local
SMTP_STARTTLS=true

# Production Guard (Strictly disables any mock/demo data)
ALLOW_DEMO_SEED=false
